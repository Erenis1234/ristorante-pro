{
  "name": "ristorante-pro",
  "version": "1.0.0",
  "author": "Ristorante Pro Team",
  "description": "App Electron con database SQLite locale",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "set ELECTRON_RUN_AS_NODE=1&& electron --test",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder",
    "desktop": "powershell -ExecutionPolicy Bypass -File .\\scripts\\create-desktop-shortcut.ps1",
    "generate-icons": "node scripts/generate-store-icons.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "better-sqlite3": "11.8.1",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "eslint": "^10.1.0",
    "sharp": "^0.33.5"
  },
  "build": {
    "productName": "Ristorante Pro",
    "appId": "com.ristorantepro.app",
    "files": [
      "electron/**",
      "supabaseClient.js",
      "index.html",
      "database/**",
      "core/**",
      "ipc/**",
      "pages/**",
      "assets/**",
      "node_modules/**"
    ],
    "directories": {
      "output": "dist/"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**"
    ],
    "extraResources": [
      {
        "from": "config/.env.production",
        "to": ".env"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "assets/images/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Ristorante Pro"
    },
    "appx": {
      "identityName": "TODO-nome-riservato-partner-center",
      "publisher": "TODO-CN-da-partner-center",
      "publisherDisplayName": "TODO-nome-editore-partner-center",
      "applicationId": "RistorantePro"
    }
  }
}
